# Defaults to prod if unset. Override to point the whole suite at another
# environment, e.g. BASE_URL=https://stage.my-drama.com
BASE_URL=https://my-drama.com

TEST_EMAIL_DOMAIN=mailinator.com

# Optional. Every worker generates its own fresh email by default (see
# src/fixtures/app.fixture.ts) — this pins ALL workers to one fixed email
# instead, e.g. to reproduce a bug tied to a specific account's accumulated
# state. This site's sign-in is passwordless (any email logs in instantly),
# so there's no password to set alongside this. Not the default: accounts
# here are never deleted, so a reused-forever email accumulates watch
# history/personalization indefinitely — see constants.ts.
# TEST_USER_EMAIL=qa-known-account@mailinator.com

# Optional. episode-boundary-and-paywall-content.spec.ts and
# free-episode-plays-without-paywall.spec.ts discover a real catalog series
# at runtime by default (see HomePage.openRegularSeriesFromGrid()) — this
# pins them to one specific series instead, e.g. to reproduce a failure tied
# to that series, or on an environment where dynamic discovery isn't wanted.
# Needs a series with some free episodes followed by locked ones.
# KNOWN_SERIES_PATH=/video/<uuid-with-free-then-locked-episodes>
